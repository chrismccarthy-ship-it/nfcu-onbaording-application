          "componentAttributes" : {
            "richTextValue" : "<!-- Generic credit-card lineup for Experience Cloud (HTML/Rich Content component).\n     Fully inline styles — no <style>, <script>, classes, pseudo-elements, or media\n     queries (the Experience Cloud sanitizer rejects those). Responsive via grid\n     auto-fit. Change href=\"/consumer/s/application\" to your card page. -->\n<div style=\"max-width:1120px;margin:0 auto;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1c2430;\">\n\n  <div style=\"margin:0 0 20px;\">\n    <h2 style=\"font-size:1.6rem;font-weight:700;color:#12294a;margin:0 0 6px;\">Find a card that works for you</h2>\n    <p style=\"color:#5b6672;margin:0;font-size:1rem;\">Compare cash back, travel, and low-rate options. No annual fee on select cards.</p>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;\">\n\n    <!-- Cash Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#1f3b63;background:linear-gradient(135deg,#1f3b63,#12294a);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Cash Rewards</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Cash Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">3% cash back in a category you choose &mdash; plus a $200 bonus offer.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; Contactless</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>2% back at grocery stores &amp; wholesale clubs</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Unlimited 1% back on everything else</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>0% intro APR for 15 billing cycles</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#012169;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Travel Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#0d6b6f;background:linear-gradient(135deg,#0d6b6f,#0a3d40);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Travel Rewards</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Travel Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">Unlimited 1.5x points on every purchase &mdash; 25,000 bonus points.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; No foreign transaction fees</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Redeem for travel, statement credit, or gift cards</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Points don&rsquo;t expire</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>0% intro APR for 15 billing cycles</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#012169;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Premium Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#3a3a3a;background:linear-gradient(135deg,#3a3a3a,#111111);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Premium</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Premium Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">2x points on travel &amp; dining, 1.5x on everything else.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">$95 annual fee &middot; Premium travel perks</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>$100 annual travel statement credit</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Airport lounge access &amp; trip protection</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>50,000 bonus points welcome offer</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#012169;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Low Intro APR -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#5a3fc0;background:linear-gradient(135deg,#5a3fc0,#2f1f74);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Low Rate</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Low Intro APR Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">0% intro APR for 18 billing cycles on purchases &amp; balance transfers.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; Contactless</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Long intro period to pay down balances</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Free monthly credit score</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>$0 fraud liability</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#012169;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <a href=\"/consumer/s/application\" style=\"display:block;margin-top:20px;background:#E31837;background:linear-gradient(135deg,#FDE8EB,##E31837);color:#ffffff;text-decoration:none;text-align:center;font-weight:700;font-size:1.05rem;padding:18px 20px;border-radius:12px;box-shadow:0 1px 3px rgba(18,41,74,.10);\">Don&rsquo;t know where to start? Let us help you! &rarr;</a>\n</div>"
