          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<div style=\"background-color: #F8F4EC; padding: 60px 40px; max-width: 800px; margin: 0 auto; font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #02214F; line-height: 1.6;\">\n \n  <h1 style=\"font-size: 2.4rem; font-weight: 700; margin-bottom: 24px; color: #02214F;\">\n    Moving? No Problem. Update Your Address in Minutes\n  </h1>\n \n  <p style=\"font-size: 1.15rem; margin-bottom: 32px; color: #333;\">\n    Life happens — new job, new home, new adventure. Keeping your address up to date with Truist ensures your statements, checks, and important notifications land in the right mailbox (the digital or physical one).\n  </p>\n \n  <div style=\"background-color: #FFFFFF; padding: 32px; border-radius: 8px; box-shadow: 0 4px 12px rgba(2, 33, 79, 0.08); margin-bottom: 40px;\">\n    <h2 style=\"font-size: 1.5rem; margin-bottom: 20px; color: #02214F; border-bottom: 2px solid #006DBA; padding-bottom: 12px;\">\n      The Quick & Easy Way (Recommended)\n    </h2>\n    <ol style=\"font-size: 1.1rem; padding-left: 20px; margin-bottom: 0;\">\n      <li style=\"margin-bottom: 16px;\">Log in to <strong>Digital Banking</strong></li>\n      <li style=\"margin-bottom: 16px;\">Go to <strong>Profile & Preferences</strong> → <strong>Profile and Contact Info</strong></li>\n      <li style=\"margin-bottom: 16px;\">Update your address and save</li>\n      <li>Done! Changes typically take effect right away for online services.</li>\n    </ol>\n  </div>\n \n  <p style=\"font-size: 1.1rem; margin-bottom: 24px;\">\n    Prefer a human touch? Call our friendly Customer Care team at <strong>888-FC DIRECT (888-323-4732)</strong>, visit a branch, or mail a written request. We’ve got you covered either way.\n  </p>\n \n  <div style=\"text-align: center; margin-top: 40px;\">\n    <a href=\"https://storm-6269dbe2d00053.my.site.com/consumer/s/address-updates\" \n       style=\"background-color: #006DBA; color: #FFFFFF; padding: 16px 40px; font-size: 1.2rem; font-weight: 600; text-decoration: none; border-radius: 6px; display: inline-block; box-shadow: 0 4px 12px rgba(0, 109, 186, 0.3);\">\n      Update My Address Now →\n    </a>\n  </div>\n \n  <p style=\"font-size: 0.95rem; color: #555; margin-top: 40px; text-align: center;\">\n    Questions? Our team is here to help. \n  </p>\n</div>"
          },
