                {
                  "componentAttributes": {
                    "richTextValue": "<!-- Checking cash-offer hero for Experience Cloud (HTML/Rich Content component).\n     Inline styles only — no <style>, classes, pseudo-elements, or scripts.\n     Generic (no brand references). Change href=\"/consumer/s/open-account\". -->\n<div style=\"background:#e9edf7;border-radius:14px;padding:40px 40px;max-width:1200px;margin:0 auto;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#C8BACB;\">\n  <p style=\"font-size:2.1rem;font-weight:400;line-height:1.1;margin:0;color:#1c2430;\">New checking customers</p>\n  <p style=\"font-size:2.3rem;font-weight:800;line-height:1.1;margin:2px 0 22px;color:#12294a;\">choose your cash offer</p>\n  <p style=\"font-size:1.05rem;line-height:1.55;margin:0 0 14px;color:#2a3542;max-width:640px;\">Open a new eligible checking account and get a <strong>$100 cash offer</strong> with qualifying debit or transfer transactions<sup style=\"font-size:.65em;\">1</sup> <strong>OR</strong> an up to <strong>$500 cash offer</strong> with Qualifying Direct Deposits.<sup style=\"font-size:.65em;\">2</sup></p>\n  <p style=\"font-style:italic;font-size:.9rem;color:#5b6672;margin:0 0 24px;\">Only one offer per customer.</p>\n  <p style=\"margin:0;display:flex;flex-wrap:wrap;gap:12px;align-items:center;\"><a href=\"/consumer/s/join\" style=\"display:inline-block;background:#043370;color:#ffffff;text-decoration:none;font-weight:700;font-size:1rem;padding:14px 28px;border-radius:999px;\">Join and open your account</a><span style=\"font-size:.9rem;color:#5b6672;\">New to Navy Federal? Become a member and open checking in one application.</span></p>\n  <p style=\"font-size:.72rem;color:#8693a5;margin:22px 0 0;line-height:1.4;\">\n    <sup>1</sup> Offer requires qualifying transactions within the first 90 days. &nbsp;\n    <sup>2</sup> Direct-deposit amount determines the cash offer tier. Terms apply.\n  </p>\n</div>"
                  },
                  "componentName": "forceCommunity:htmlBlock",
                  "id": "b5349963-ce41-4cb9-a155-6cbf27530550",
                  "renderPriority": "NEUTRAL",
                  "renditionMap": {},
                  "type": "component"
                },
                {
                  "componentAttributes": {
                    "richTextValue": "<!-- Generic credit-card lineup for Experience Cloud (HTML/Rich Content component).\n     Fully inline styles — no <style>, <script>, classes, pseudo-elements, or media\n     queries (the Experience Cloud sanitizer rejects those). Responsive via grid\n     auto-fit. Change href=\"/consumer/s/application\" to your card page. -->\n<div style=\"max-width:1120px;margin:0 auto;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1c2430;\">\n\n  <div style=\"margin:0 0 20px;\">\n    <h2 style=\"font-size:1.6rem;font-weight:700;color:#12294a;margin:0 0 6px;\">Find a card that works for you</h2>\n    <p style=\"color:#5b6672;margin:0;font-size:1rem;\">Compare cash back, travel, and low-rate options. No annual fee on select cards.</p>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;\">\n\n    <!-- Cash Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#1f3b63;background:linear-gradient(135deg,#1f3b63,#12294a);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Cash Rewards</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Cash Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">3% cash back in a category you choose &mdash; plus a $200 bonus offer.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; Contactless</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>2% back at grocery stores &amp; wholesale clubs</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Unlimited 1% back on everything else</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>0% intro APR for 15 billing cycles</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#12294a;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Travel Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#0d6b6f;background:linear-gradient(135deg,#0d6b6f,#0a3d40);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Travel Rewards</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Travel Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">Unlimited 1.5x points on every purchase &mdash; 25,000 bonus points.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; No foreign transaction fees</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Redeem for travel, statement credit, or gift cards</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Points don&rsquo;t expire</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>0% intro APR for 15 billing cycles</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#12294a;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Premium Rewards -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#3a3a3a;background:linear-gradient(135deg,#3a3a3a,#111111);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Premium</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Premium Rewards Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">2x points on travel &amp; dining, 1.5x on everything else.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">$95 annual fee &middot; Premium travel perks</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>$100 annual travel statement credit</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Airport lounge access &amp; trip protection</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>50,000 bonus points welcome offer</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#12294a;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Low Intro APR -->\n    <div style=\"display:flex;flex-direction:column;border:1px solid #e4e7ec;border-radius:14px;background:#ffffff;overflow:hidden;box-shadow:0 1px 3px rgba(18,41,74,.08);\">\n      <div style=\"height:150px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;color:#ffffff;background:#5a3fc0;background:linear-gradient(135deg,#5a3fc0,#2f1f74);\">\n        <div style=\"width:34px;height:24px;border-radius:5px;background:#c8a24a;background:linear-gradient(135deg,#e9cf8a,#c8a24a);\"></div>\n        <div style=\"font-family:monospace;letter-spacing:.14em;font-size:.95rem;opacity:.92;\">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 0000</div>\n        <div style=\"font-size:.66rem;text-transform:uppercase;letter-spacing:.14em;opacity:.85;\">Low Rate</div>\n      </div>\n      <div style=\"padding:18px;display:flex;flex-direction:column;gap:10px;flex:1;\">\n        <p style=\"font-size:1.12rem;font-weight:700;color:#12294a;margin:0;\">Low Intro APR Card</p>\n        <p style=\"color:#b3123b;font-weight:600;font-size:.95rem;margin:0;\">0% intro APR for 18 billing cycles on purchases &amp; balance transfers.</p>\n        <p style=\"color:#5b6672;font-size:.8rem;margin:0;\">No annual fee &middot; Contactless</p>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Long intro period to pay down balances</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>Free monthly credit score</span></div>\n        <div style=\"display:flex;gap:8px;font-size:.86rem;color:#3a4451;\"><span style=\"color:#15803d;font-weight:700;\">&check;</span><span>$0 fraud liability</span></div>\n        <div style=\"margin-top:auto;padding-top:12px;display:flex;align-items:center;gap:14px;\">\n          <a href=\"/consumer/s/application\" style=\"display:inline-block;background:#12294a;color:#ffffff;text-decoration:none;font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:8px;\">Apply Now</a>\n          <a href=\"#\" style=\"color:#12294a;font-weight:600;font-size:.86rem;text-decoration:none;\">Learn more</a>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>"
                  },
