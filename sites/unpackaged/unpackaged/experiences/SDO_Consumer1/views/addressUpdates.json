          "componentAttributes" : {
            "richTextValue" : "<div style=\"background-color: #F8F4EC; padding: 60px 40px; max-width: 800px; margin: 0 auto; font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #02214F; line-height: 1.6;\">\n \n  <h1 style=\"font-size: 2.35rem; font-weight: 700; margin-bottom: 24px; color: #02214F;\">\n    Update Your Address – Right Here, Right Now\n  </h1>\n \n  <p style=\"font-size: 1.18rem; margin-bottom: 32px; color: #333;\">\n    Moving to a new home? Just need to correct your mailing address? You’re in the right place.\n    Use the secure form below to update your address with First Citizens Bank quickly and easily.\n  </p>\n \n  <div style=\"background-color: #FFFFFF; padding: 36px; border-radius: 12px; box-shadow: 0 4px 20px rgba(2, 33, 79, 0.08); margin-bottom: 40px;\">\n    <h2 style=\"font-size: 1.55rem; margin-bottom: 20px; color: #02214F;\">\n      What You’ll Need\n    </h2>\n    <ul style=\"font-size: 1.1rem; line-height: 1.75; padding-left: 20px; margin: 0;\">\n      <li>Verify your current mailing and physical address (if different)</li>\n      <li>New address details</li>\n      <li>Effective date (when you want the change to start)</li>\n    </ul>\n  </div>\n \n  <p style=\"font-size: 1.1rem; margin-bottom: 8px; color: #444;\">\n    ✅ Most updates are processed immediately for online services.\n    No paperwork is required for standard personal accounts.\n  </p>\n \n  <p style=\"font-size: 1.05rem; text-align: center; margin-top: 40px; color: #555;\">\n    Scroll down and fill out the form below to get started.\n  </p>\n \n</div>"
