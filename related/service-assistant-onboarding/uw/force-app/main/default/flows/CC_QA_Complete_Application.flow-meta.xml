    <description>Credit Card Account Opening quick action. 4-step wizard (membership, identity document, card and options, review) that completes the member&apos;s credit card application and saves it to the matching Application__c record with status In Review.</description>
    <environments>Default</environments>
    <formulas>
        <name>applicationName</name>
        <dataType>String</dataType>
        <expression>{!Get_Matching_Application.Name}</expression>
    </formulas>
    <formulas>
        <name>bt2Amount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!wizardCmp.outBt2Amount}), NULL, VALUE({!wizardCmp.outBt2Amount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>caseIdResolved</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Messaging_Session.CaseId}, {!inputId})</expression>
    </formulas>
    <formulas>
        <name>inputId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!recordId}, {!caseId})</expression>
    </formulas>
    <interviewLabel>CC - Complete Card Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CC - Complete Card Application</label>
