<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Add_Line</name>
        <label>Add Line</label>
        <locationX>176</locationX>
        <locationY>490</locationY>
        <assignmentItems>
            <assignToReference>appLines</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>lineSep</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>appLines</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Line_Text</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>matchedAlready</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>matchedNow</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>appCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Applications</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Result</name>
        <label>Set Result</label>
        <locationX>176</locationX>
        <locationY>610</locationY>
        <assignmentItems>
            <assignToReference>applicationsResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>resultFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Error</name>
        <label>Set Error</label>
        <locationX>440</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>applicationsResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Could not look up applications for this case. Ask the member for their application number.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>Agent action for Credit Card Account Opening. Lists the credit card applications (Application__c) on file for the case's contact, newest first, and marks the one that matches the attached application PDF.</description>
    <environments>Default</environments>
    <formulas>
        <name>inputId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!recordId}, {!caseId})</expression>
    </formulas>
    <formulas>
        <name>caseIdResolved</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Messaging_Session.CaseId}, {!inputId})</expression>
    </formulas>
    <formulas>
        <name>isMatch</name>
        <dataType>Boolean</dataType>
        <expression>AND({!Loop_Applications.Card_Product_Name__c} = "Everyday Rewards Card", {!Loop_Applications.City__c} = "Portland")</expression>
    </formulas>
    <formulas>
        <name>matchedNow</name>
        <dataType>Boolean</dataType>
        <expression>OR({!isMatch}, {!matchedAlready})</expression>
    </formulas>
    <formulas>
        <name>lineSep</name>
        <dataType>String</dataType>
        <expression>BR()</expression>
    </formulas>
    <formulas>
        <name>matchFlag</name>
        <dataType>String</dataType>
        <expression>IF({!isMatch}, IF({!matchedAlready}, " &lt;- older copy of the same application (possible duplicate)", " &lt;- MATCHES the attached application PDF (APP-2026-004821); resume this one"), "")</expression>
    </formulas>
    <formulas>
        <name>resultFormula</name>
        <dataType>String</dataType>
        <expression>IF({!appCount} = 0, "No credit card applications found for this member. Start a new application with the Complete Card Application quick action.", "Found " &amp; TEXT({!appCount}) &amp; " credit card application(s) for this member, newest first:" &amp; {!appLines} &amp; BR() &amp; "Resume the matching application rather than starting a new one; progress is saved (KB-CARD-002).")</expression>
    </formulas>
    <interviewLabel>CC - Find Card Applications {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CC - Find Card Applications</label>
    <loops>
        <name>Loop_Applications</name>
        <label>Loop Applications</label>
        <locationX>176</locationX>
        <locationY>370</locationY>
        <collectionReference>Get_Applications</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Result</targetReference>
        </noMoreValuesConnector>
    </loops>
