<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Card Opening - Review Application</masterLabel>
    <description>Parses the attached credit card application with membership, requirement and identity checks.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Case Id" role="inputOnly"/>
            <property name="fileName" type="String" label="Attached file name" role="inputOnly"/>
            <property name="applicationName" type="String" label="Matching application name" role="inputOnly"/>
            <property name="applicationId" type="String" label="Matching application Id" role="inputOnly"/>
            <property name="outcome" type="String" label="Outcome" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>