<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Underwriting - Initiate Slack Swarm</masterLabel>
    <description>Mock Slack swarm launcher for the Underwriter Workflow quick action.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Case Id" role="inputOnly"/>
            <property name="swarmReason" type="String" label="Swarm reason (fraud, mismatch, title, dealer, exception, compliance)" role="inputOnly"/>
            <property name="outcome" type="String" label="Outcome" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
