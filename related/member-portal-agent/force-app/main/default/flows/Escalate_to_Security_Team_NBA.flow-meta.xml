<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Demo_Member</name>
        <label>Assign Demo Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Demo_Member.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Member</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_From_Session</name>
        <label>Assign From Session</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Messaging_Session.EndUserContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varParentCaseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Messaging_Session.CaseId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Member</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Session_Contact</name>
        <label>Has Session Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Demo_Member</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No session contact</defaultConnectorLabel>
        <rules>
            <name>Session_Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Messaging_Session.EndUserContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_From_Session</targetReference>
            </connector>
            <label>Session contact found</label>
        </rules>
    </decisions>
    <description>Navy Federal branded Next Best Action screen flow. Recommends escalating a flagged application (overseas address change caught by identity and fraud verification) to the NFCU Security Team, then creates a High-priority Security Team case linked to the member and the chat&apos;s escalation case.</description>
    <environments>Default</environments>
    <formulas>
        <name>fMemberName</name>
        <dataType>String</dataType>
        <expression>{!Get_Member.FirstName} &amp; &quot; &quot; &amp; {!Get_Member.LastName}</expression>
    </formulas>
    <interviewLabel>Escalate to Security Team (NBA) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Escalate to Security Team (Next Best Action)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Security_Case</name>
        <label>Create Security Team Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>varNewCaseId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_New_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Get_Member.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>varContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ttCaseDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Chat</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Security_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>varParentCaseId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>ttCaseSubject</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Application</name>
        <label>Get Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Security_Queue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>FraudFlag__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ApplicantForm__c</object>
        <sortField>ApplicationDate__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Demo_Member</name>
        <label>Get Demo Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Demo_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FirstName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lauren</stringValue>
            </value>
        </filters>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Bailey</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Member</name>
        <label>Get Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Application</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Messaging_Session</name>
        <label>Get Messaging Session</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Session_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>MessagingSession</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Case</name>
        <label>Get New Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Escalation_Sent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varNewCaseId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Security_Queue</name>
        <label>Get Security Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recommend_Escalation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>NFCU_Security_Team</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Escalation_Sent</name>
        <label>Escalated to the Security Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Escalation_Confirmation</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(4, 51, 112); font-size: 16px;&quot;&gt;Escalated to the NFCU Security Team&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Case &lt;strong&gt;{!Get_New_Case.CaseNumber}&lt;/strong&gt; is in the Security Team queue at High priority, linked to {!fMemberName} and this conversation.&lt;/p&gt;&lt;p&gt;Let {!Get_Member.FirstName} know the Security Team will complete the fraud check and she won&apos;t need to repeat anything.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Recommend_Escalation</name>
        <label>Escalate to Security Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Security_Case</targetReference>
        </connector>
        <fields>
            <name>NFCU_Security_Escalation</name>
            <extensionName>c:nfcuSecurityEscalation</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>memberName</name>
                <value>
                    <elementReference>fMemberName</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>productName</name>
                <value>
                    <elementReference>Get_Application.ProductType__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>applicationNumber</name>
                <value>
                    <elementReference>Get_Application.Name</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>identityStatus</name>
                <value>
                    <elementReference>Get_Application.IdentityVerificationStatus__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>kycStatus</name>
                <value>
                    <elementReference>Get_Application.KYCStatus__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>fraudReason</name>
                <value>
                    <elementReference>Get_Application.FraudFlagReason__c</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <fields>
            <name>Security_Notes</name>
            <fieldText>Notes for the Security Team (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Escalate to Security Team</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Messaging_Session</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttCaseDescription</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SECURITY TEAM FRAUD CHECK REQUESTED

Member: {!fMemberName}
Application: {!Get_Application.Name} - {!Get_Application.ProductType__c} ({!Get_Application.Status__c})
Fraud flag: {!Get_Application.FraudFlagReason__c}
Identity verification: {!Get_Application.IdentityVerificationStatus__c}
KYC: {!Get_Application.KYCStatus__c}

Reason: The member changed her mailing address to an overseas APO address (PCS move) while the application was open. The external identity and fraud verification flagged the change. A Security Team fraud check is required before approval.

Verification data was received through MuleSoft with PII masked and tokenized (SSN ***-**-1234).

MSR notes:
{!Security_Notes}</text>
    </textTemplates>
    <textTemplates>
        <name>ttCaseSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Security Team fraud check: {!fMemberName} - {!Get_Application.ProductType__c} application</text>
    </textTemplates>
    <variables>
        <description>Record the Next Best Action runs on (the Messaging Session in the console).</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewCaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varParentCaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
