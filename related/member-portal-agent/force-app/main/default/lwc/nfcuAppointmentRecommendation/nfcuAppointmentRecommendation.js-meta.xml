<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>NFCU Account Opening Recommendation</masterLabel>
    <description>Navy Federal branded Next Best Action screen for booking a household account-opening appointment.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="memberName" type="String" label="Member name" default="Lauren Bailey"/>
            <property name="prospectLabel" type="String" label="Who is joining" default="Her fiancé (joining as her spouse)"/>
            <property name="schedulerUrl" type="String" label="Scheduling page URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
