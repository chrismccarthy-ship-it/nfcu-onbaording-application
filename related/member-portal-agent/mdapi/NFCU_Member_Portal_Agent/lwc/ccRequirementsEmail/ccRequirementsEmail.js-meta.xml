<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Card Opening - Email Requirements</masterLabel>
    <description>Composes the email to the member listing what is still required for the credit card application, and shows the send confirmation.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Case Id" role="inputOnly"/>
            <property name="mode" type="String" label="Mode (compose or sent)" role="inputOnly"/>
            <property name="sentSubject" type="String" label="Sent subject" role="inputOnly"/>
            <property name="sentItemCount" type="Integer" label="Sent item count" role="inputOnly"/>
            <property name="emailSubject" type="String" label="Email subject" role="outputOnly"/>
            <property name="emailBody" type="String" label="Email body" role="outputOnly"/>
            <property name="itemCount" type="Integer" label="Items requested" role="outputOnly"/>
            <property name="outcome" type="String" label="Outcome" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>